<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Assistant.Core</RootNamespace>

    <!--
      Native AOT 相容設定：
      此 Class Library 本身不啟用 PublishAot（由 Assistant.App 主程式設定），
      但需確保程式碼本身符合 AOT 限制：
        - 禁用反射型 JSON 序列化（使用 Source Generator）
        - 不使用 dynamic / Activator.CreateInstance 等動態程式碼
    -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsTrimmable>true</IsTrimmable>
    <TrimmerRootDescriptor>TrimmerRoots.xml</TrimmerRootDescriptor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
    <PackageReference Include="LanceDB" Version="2.4.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
  </ItemGroup>

  <!--
    TODO: 加入套件後請確認各套件的 AOT 相容性：
      - LanceDB .NET SDK (Native Interop)
      - System.Data.SQLite 或 Microsoft.Data.Sqlite
  -->

</Project>
