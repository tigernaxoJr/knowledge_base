<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Assistant.App</RootNamespace>

    <!-- 前端原始碼根目錄（相對於此 .csproj） -->
    <FrontendDir>$(MSBuildProjectDirectory)/../frontend</FrontendDir>
    <!-- Vite build 輸出目錄 -->
    <FrontendDistDir>$(FrontendDir)/dist</FrontendDistDir>
  </PropertyGroup>

  <!--
    Native AOT：WinForms 不允許在一般 build 中開啟 PublishAot（NETSDK1175）。
    僅在明確指定 RuntimeIdentifier（即 dotnet publish -r win-x64）時才啟用。
    發布指令：dotnet publish -c Release -r win-x64 /p:PublishAot=true
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishAot>true</PublishAot>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!-- ── NuGet 套件 ──────────────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
  </ItemGroup>

  <!-- ── 專案參考 ───────────────────────────────────────────────────────── -->
  <ItemGroup>
    <ProjectReference Include="..\Assistant.Core\Assistant.Core.csproj" />
  </ItemGroup>

  <!--
    ── MSBuild Target 1：在 Build / Publish 前執行前端 Build ──────────────
    條件：dist/ 目錄不存在，或強制重建（環境變數 FORCE_FRONTEND_BUILD=1）
  -->
  <Target Name="BuildFrontend"
          BeforeTargets="Build;Publish"
          Condition="!Exists('$(FrontendDistDir)/index.html') Or '$(FORCE_FRONTEND_BUILD)' == '1'">
    <Message Text="[Build Pipeline] Installing frontend dependencies..." Importance="high" />
    <Exec Command="pnpm install" WorkingDirectory="$(FrontendDir)" />
    <Message Text="[Build Pipeline] Building frontend with Vite..." Importance="high" />
    <Exec Command="pnpm run build" WorkingDirectory="$(FrontendDir)" />
  </Target>

  <!--
    ── MSBuild Target 2：將 dist/ 下所有靜態資源宣告為 Embedded Resource ──
    LogicalName 命名規則：frontend/<相對路徑>
    後端透過 Assembly.GetManifestResourceStream("frontend/index.html") 讀取。
  -->
  <Target Name="IncludeFrontendDist"
          AfterTargets="BuildFrontend"
          BeforeTargets="BeforeBuild"
          Condition="Exists('$(FrontendDistDir)')">
    <ItemGroup>
      <EmbeddedResource
        Include="$(FrontendDistDir)/**/*"
        LogicalName="frontend/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
